{
  "name": "pi-narrative",
  "version": "0.5.0",
  "description": "Agent-based game narrative pipeline for Pi with deterministic engine export, idempotent consequence delivery, checkpoints, and save snapshots.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node --test",
    "validate:project": "node scripts/validate-project.mjs",
    "check:docs": "node scripts/check-doc-translations.mjs",
    "check": "node scripts/check-package.mjs && node scripts/check-doc-translations.mjs && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": { "extensions": ["extensions"], "skills": ["skills"] },
  "files": [
    "extensions", "src", "skills", "scripts", "examples/unity", "docs",
    "README.md", "README.zh-CN.md", "CHANGELOG.md", "CHANGELOG.zh-CN.md",
    "CONTRIBUTING.md", "CONTRIBUTING.zh-CN.md", "LICENSE"
  ],
  "keywords": ["pi", "agent", "narrative", "game-writing", "unity", "middleware", "storytelling"]
}
